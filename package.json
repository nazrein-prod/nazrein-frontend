{
  "name": "client",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,css,md,json}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,css,md,json}\""
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.5.4",
    "typescript": "5.8.2"
  },
  "packageManager": "pnpm@10.4.0",
  "engines": {
    "node": ">=20"
  }
}
